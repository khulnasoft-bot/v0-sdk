# Forecast API key with Vercel credentials embedded in the token.
# Optional locally; when unset, the web app opens an API key dialog on first
# load and stores the key in an HTTP-only cookie. Set the same key on both the
# web app and the preview proxy, or leave it unset on both.
V0_API_KEY=

# Public origin of the preview proxy deployment, e.g. https://preview-proxy.example.com.
# Required in production when the proxy is not linked as a Vercel Related Project.
# Must be an HTTP(S) origin without a path. Locally the web app defaults to
# http://localhost:3001.
V0_PREVIEW_PROXY_URL=

# Public origin of the web app deployment, e.g. https://web.example.com.
# Required in production when the web app is not linked as a Vercel Related
# Project. Must use HTTPS on Vercel. Locally the proxy defaults to
# http://localhost:3000.
V0_CLONE_ORIGIN=

# Figma OAuth credentials for importing Figma files.
# Get these from https://www.figma.com/developers/api#oauth-tokens.
# The redirect URI must match the app origin (e.g. https://web.example.com).
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=